# ── API Integration Configuration ──────────────────────────────────────
# The URL pointing to your live Render backend or local FastAPI instance.
# Next.js API routes will proxy scan requests to this URL.
BACKEND_API_URL=https://scamsentry-backend-j7a8.onrender.com
API_SECRET_KEY=your-api-secret-key-here
CRON_SECRET=your-cron-secret-token-here

# ── Firebase Client Configuration (Optional in Demo Mode) ──────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ── Firebase Admin SDK Configuration (Server-Side Only) ─────────────────
# Entire Service Account JSON from Firebase Console > Project Settings > Service Accounts
# Stringified into a single line
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key":"..."}
